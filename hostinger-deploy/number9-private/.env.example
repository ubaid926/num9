# ==============================================================
# Number9 - Private SMTP & Backend Environment Configuration
# ==============================================================
# Safe template for production credentials.
# Placed in 'number9-private/.env' (outside public_html)

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=info@number9.us
SMTP_PASS=your_email_password_here
SMTP_FROM_EMAIL=info@number9.us
SMTP_FROM_NAME="Number9 Contact Form"
RECIPIENT_EMAIL=info@number9.us
RECIPIENT_NAME="Number9 Team"

ALLOWED_ORIGINS="https://number9.us,https://www.number9.us,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=600
MIN_SUBMISSION_TIME_SECONDS=2

