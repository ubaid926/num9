# ==============================================================
# Number9 - Contact Form SMTP & Backend Environment Configuration
# ==============================================================
# Copy this file to '.env' (in the backend folder OR outside public_html on Hostinger)
# and fill in your actual SMTP mail server credentials.
# NEVER commit the real '.env' file to Git!

# --- Hostinger SMTP Credentials ---
# For Hostinger Titan/Business Email: smtp.titan.email (SSL port 465)
# For Hostinger Standard Webmail: smtp.hostinger.com (SSL port 465 or TLS port 587)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=ssl

# Your Number9 email address and email password created in Hostinger hPanel -> Emails
SMTP_USER=info@number9.us
SMTP_PASS=your_hostinger_email_password_here

# Sender info
SMTP_FROM_EMAIL=info@number9.us
SMTP_FROM_NAME="Number9 Contact Form"

# Where customer inquiries will be delivered
RECIPIENT_EMAIL=info@number9.us
RECIPIENT_NAME="Number9 Team"

# --- Security & CORS Settings ---
# Comma-separated list of allowed origins (leave as is for production + local dev)
ALLOWED_ORIGINS="https://number9.us,https://www.number9.us,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# --- Rate Limiting & Anti-Spam ---
# Maximum number of submissions allowed per IP within the time window
RATE_LIMIT_MAX_REQUESTS=5

# Time window in seconds (600 = 10 minutes)
RATE_LIMIT_WINDOW_SECONDS=600

# Minimum time (in seconds) between form render and submission to defeat instant automated bots
MIN_SUBMISSION_TIME_SECONDS=2

